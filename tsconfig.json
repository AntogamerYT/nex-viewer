{
	"files": [],
	"references": [{ "path": "./tsconfig.node.json" }, { "path": "./tsconfig.web.json" }],
	"compilerOptions": {
		"strict": true,
		"strictPropertyInitialization": false,
		"declaration": true,
		"resolveJsonModule": true,
		"module": "commonjs",
		"esModuleInterop": true,
		"moduleResolution": "node",
		"baseUrl": ".",
		"outDir": "./out",
		"allowJs": true,
		"target": "es2022",
		"noEmitOnError": true,
	}
}

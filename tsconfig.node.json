{
  "extends": "@electron-toolkit/tsconfig/tsconfig.node.json",
  "include": [
    "electron.vite.config.*",
    "src/**/*"
  ],
  "exclude": [
    "src/renderer/**/*"
  ],
  "compilerOptions": {
		"strictPropertyInitialization": false,
    "composite": true,
    "types": ["electron-vite/node"],
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "src/*"
      ]
    }
  }
}
